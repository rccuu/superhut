/**
 * 获取浴室预约时间分组时间点集合
 * @param orderDate 预约日期
 * @param grouptime 分组间隔时间
 * @param delaytime 延时间隔时间
 * @param startdate 浴室开放时间
 * @param enddate   浴室关闭时间
 * @param bantime   浴室禁止开放时间
 * @returns {*}
 */
function getTimeGroupPoint(orderDate, grouptime, delaytime, startdate, enddate, bantime) {

    var timeList = [];//所有开放关闭浴室时间点集合
    timeList.unshift(startdate);
    timeList.unshift(enddate);
    //将浴室禁止开放时间分割
    var timeArr = bantime.split(";");
    for (var i in timeArr) {
        var timeStr = timeArr[i].split("-");
        if (timeStr[0] != timeStr[1]) {
            timeList.unshift(timeStr[0]);
            timeList.unshift(timeStr[1]);
        }
    }
    //将时间段按从小到大排序 ["01:00", "12:00", "16:00", "23:30"]
    for (var i = 0; i < timeList.length - 1; i++) {
        for (var j = 0; j < timeList.length - i - 1; j++) {
            var one = timeList[j].replace(":", "");
            var two = timeList[j + 1].replace(":", "");
            if (one > two) {
                var temp = timeList[j];
                timeList[j] = timeList[j + 1];
                timeList[j + 1] = temp;
            }
        }
    }
    //console.log(timeList);

    //将上面排序的时间点两两组合分成时间段["16:00-23:30", "06:30-12:00"]
    var openTimeList = [];
    for (var i = 0; i < timeList.length / 2; i++) {
        var start = timeList[(i + 1) * 2 - 2];
        var end = timeList[(i + 1) * 2 - 1];
        openTimeList.unshift(start + "-" + end);
    }
    // console.log(openTimeList);

    //按照时间间隔，取各个开放时间段固定间隔时间点集合
    var dateList = [];
    for (var i = openTimeList.length - 1; i >= 0; i--) {
        var openTimeArr = openTimeList[i].split("-");
        var startTime = new Date(orderDate.replace("-", "/").replace("-", "/") + " " + openTimeArr[0]);
        var endTime = new Date(orderDate.replace("-", "/").replace("-", "/") + " " + openTimeArr[1]);
        while (endTime >= startTime) {
            var hour = startTime.getHours();
            var minute = startTime.getMinutes();
            if (minute == 60) {
                hour = hour + 1;
                minute = '00';
            }
            if (hour < 10) {
                hour = "0" + hour;
            }
            if (minute.toString().length == 1) {
                minute = "0" + minute;
            }
            dateList.unshift(hour + ':' + minute);
            startTime = new Date(startTime.getTime() + grouptime * 60 * 1000);
        }
        //dateList.unshift(openTimeArr[0]);
    }
    // console.log(dateList);
    return getTimeGroupSlot(dateList, openTimeList, orderDate, delaytime);
}

/**
 * 获取浴室预约时间分组时间段集合
 * @param dateList        分组时间点集合
 * @param openTimeList    开放时间段集合
 * @param orderDate       预约日期
 * @param delaytime       预留清场时间（每个预约时间段减去x分组，例如：07:00-07:30, 预留5分钟后预约时间段为07:00-07:25）
 * @returns {*[]}
 */
function getTimeGroupSlot(dateList, openTimeList, orderDate, delaytime) {
    var newdateList = [];
    if (dateList != null && dateList.length > 0) {
        for (var i = dateList.length - 1; i >= 0; i--) {
            var currTime = new Date();//当前时间
            var timeStr = orderDate.replace("-", "/").replace("-", "/") + " " + dateList[i];
            var timeDate = new Date(new Date(timeStr).getTime() - delaytime * 60 * 1000);//分组时间点
            if (currTime < timeDate) {
                if (openTimeList != null && openTimeList.length > 0) {
                    for (var j = openTimeList.length - 1; j >= 0; j--) {
                        var openTimeArr = openTimeList[j].split("-");
                        var startTime = openTimeArr[0].replace(":", "");//new Date(orderDate + " " + openTimeArr[0]);
                        var endTime = openTimeArr[1].replace(":", "");//new Date(orderDate + " " + openTimeArr[1]);

                        var result = dateList[i + 1].replace(":", "");
                        var resultend = dateList[i].replace(":", "");
                        if (result >= startTime && result < endTime && resultend > startTime && resultend <= endTime) {
                            newdateList.unshift(dateList[i + 1] + " - " + dateList[i]);
                        }
                    }
                }
            }
        }
    }
    if (newdateList.length == 0) {
        newdateList.unshift("不在浴室开放时间");
    }
    // console.log(newdateList);
    return newdateList.reverse();
}

//获取当前日期
function getCurrentDate() {
    var time = new Date()
    var day = ('0' + time.getDate()).slice(-2)
    var month = ('0' + (time.getMonth() + 1)).slice(-2)
    var today = time.getFullYear() + '-' + month + '-' + day
    return today;
}

//根据时间段动态展示剩余终端龙头数量
function getNumberTerminals(selectvalue, bathroomcode) {
    var satatdate = selectvalue.substring(0, 5);
    var enddate = selectvalue.substring(8, selectvalue.length);
    var param = new Object();
    param.bathroomcode = bathroomcode;
    param.startdate = satatdate.replace(" ", "");
    param.enddate = enddate.replace(" ", "");
    dkyw.request.post("/bathroom/getNumberTerminals", param, function (response) {
        if (response.success) {
            var data = response.resultData;
            if ("000000" == data.result) {
                $("#number" + bathroomcode + "").val(data.data.number);
            } else {
                $("#number" + bathroomcode + "").val("龙头数量异常");
            }
        } else {
            $("#number" + bathroomcode + "").val("龙头数量异常");
        }
    })
}

